<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Expert Opinion - MoneyMap</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= action_cable_meta_tag %>
  <!-- Chartkick not needed here, but keeping CDN imports clean -->
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <style>
    body {
      background-color: #f3f4f6;
      display: flex;
      min-height: 100vh;
      font-family: Arial, sans-serif;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: white;
      box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
      padding: 10px 20px;
      width: 100%;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
    }
    .logo-container img {
      height: 50px;
    }
    .profile-container {
      display: flex;
      align-items: center;
    }
    .profile-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background-color: #ccc;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 10px;
      text-decoration: none;
      color: #374151;
    }
    .logout {
      font-size: 1rem;
      color: #ff4949;
      text-decoration: none;
      font-weight: bold;
    }
    .logout:hover {
      text-decoration: underline;
    }
    .sidebar {
      background-color: white;
      box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
      padding: 20px;
      position: fixed;
      top: 70px;
      left: 0;
      height: calc(100vh - 70px);
      width: 260px;
      display: flex;
      flex-direction: column;
    }
    .sidebar a {
      padding: 15px;
      margin-bottom: 10px;
      font-size: 1rem;
      color: #374151;
      text-decoration: none;
      border-radius: 5px;
    }
    .sidebar a.active, .sidebar a:hover {
      background-color: #7edc97;
      color: white;
    }
    .content {
      margin-left: 270px;
      padding: 20px;
      width: calc(100% - 270px);
      margin-top: 60px;
    }
    .expert-cards-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
    }
    .expert-card {
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      cursor: pointer;
      transition: transform 0.2s;
    }
    .expert-card:hover {
      transform: translateY(-5px);
    }
    .expert-header h2 {
      font-size: 1.5rem;
      font-weight: bold;
      color: #374151;
    }
    .expert-designation {
      color:rgb(57, 57, 57);
      font-size: 1rem;
    }
    .expert-details p {
      margin: 5px 0;
      color: #666;
    }
    .expert-details span {
      font-weight: bold;
      color: #374151;
    }
    .charges {
      margin-top: 10px;
      color: #059669;
    }
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }
    .modal.show {
      display: flex;
    }
    .modal-content {
      background-color: white;
      padding: 20px;
      width: 50%;
      max-height: 80vh;
      overflow-y: auto;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .close-button {
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
    }
    .modal-body p {
      margin: 5px 0;
    }
    .designation {
      color:rgb(58, 58, 58);
      font-size: 1.1rem;
    }
    .expert-info span:first-child {
      font-weight: bold;
      color: #374151;
    }
    .session-charges {
      color: #059669;
      font-weight: bold;
      margin-top: 10px;
    }
    .time-slot-section {
      margin-top: 20px;
    }
    .time-slot-section h3 {
      color: #374151;
    }
    .time-slot-selector select, .time-slot-selector input {
      width: 100%;
      padding: 8px;
      border: 1px solid #d1d5db;
      border-radius: 5px;
    }
    .book-session-btn {
      display: inline-block;
      margin-top: 20px;
      padding: 10px 20px;
      background-color:rgb(74, 156, 96);
      color: white;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
    }
    .book-session-btn:hover {
      background-color: #60be79;
    }
    .book-session-btn.disabled {
      background-color: #d1d5db;
      cursor: not-allowed;
    }
    #slot-status {
      margin-top: 10px;
      color: #666;
    }
    #no-results {
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header>
    <div class="logo-container">
      <%= image_tag "money_map.png", alt: "MoneyMap Logo" %>
    </div>
    <div class="profile-container">
      <%= link_to "👤", profile_path, class: "profile-icon" %>
      <%= link_to "Log Out", signout_path, data: { turbo_method: :delete }, class: "logout" %>
    </div>
  </header>

  <!-- Sidebar -->
  <aside class="sidebar">
    <%= link_to "Dashboard", dashboard_path, class: "#{current_page?(dashboard_path) ? 'active' : ''}" %>
    <%= link_to "Enter / Edit Spends", expenses_path, class: "#{current_page?(expenses_path) ? 'active' : ''}" %>
    <%= link_to "Expert Opinion", expert_opinion_path, class: "#{current_page?(expert_opinion_path) ? 'active' : ''}" %>
    <%= link_to "Live Chat 💬", user_chat_path, class: "#{current_page?(user_chat_path) ? 'active' : ''}" %>
  </aside>

  <!-- Main Content -->
  <main class="content">
    <h1 class="text-2xl font-bold mb-6">Expert Opinion</h1>
    
    <!-- Search Bar -->
    <input id="expert-search" type="text" placeholder="Search by name, experience, charges, designation, or date..." class="w-full p-2 border rounded mt-4 mb-6">
    <div id="no-results" class="hidden text-center text-gray-500">No experts found matching your search.</div>

    <div class="expert-cards-container">
      <% @experts.each do |expert| %>
        <div class="expert-card" 
             data-name="<%= expert.name.downcase %>" 
             data-experience="<%= expert.experience || 0 %>" 
             data-charges="<%= expert.charges_per_session || 0 %>" 
             data-designation="<%= expert.designation ? expert.designation.downcase : '' %>" 
             data-updated-at="<%= expert.updated_at.strftime('%b %d, %Y').downcase %>"
             onclick="showModal('<%= expert.name %>', '<%= expert.designation %>', '<%= expert.age %>', '<%= expert.experience %>', '<%= expert.about %>', '<%= expert.charges_per_session %>', '<%= expert.id %>')">
          <div class="expert-header">
            <h2 class="expert-name"><%= expert.name %></h2>
            <p class="expert-designation"><%= expert.designation || "Designation not specified" %></p>
          </div>
          <div class="expert-details">
            <p><span>Age:</span> <%= expert.age || "Not specified" %></p>
            <p><span>Experience:</span> <%= expert.experience ? "#{expert.experience} years" : "Not specified" %></p>
            <p class="charges"><span>Session Charges:</span> ₹<%= expert.charges_per_session || "Not specified" %></p>
          </div>
        </div>
      <% end %>
    </div>
  </main>

  <!-- Modal -->
  <div id="expertModal" class="modal hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modalExpertName" class="text-2xl font-bold"></h2>
        <button onclick="closeModal()" class="close-button">×</button>
      </div>
      <div class="modal-body">
        <p class="designation"></p>
        <div class="expert-info">
          <p><span>Age:</span> <span id="modalAge"></span></p>
          <p><span>Experience:</span> <span id="modalExperience"></span></p>
          <p><span>About:</span> <span id="modalAbout"></span></p>
        </div>
        <p class="session-charges"></p>
        
        <!-- Time Slot Selection -->
        <div class="time-slot-section">
          <h3 class="text-lg font-semibold mb-3">Select Time Slot</h3>
          <div class="time-slot-selector">
            <label for="booking-date" class="block text-sm font-medium text-gray-700 mb-2">Select Date:</label>
            <input type="date" id="booking-date" 
                   min="<%= Date.today %>" 
                   class="mb-4 p-2 border rounded-md w-full"
                   required>
            
            <label for="booking-time" class="block text-sm font-medium text-gray-700 mb-2">Select Time Slot:</label>
            <select id="booking-time" class="p-2 border rounded-md w-full" required>
              <option value="">Select a time slot</option>
              <% (9..19).each do |hour| %>
                <option value="<%= "#{hour}:00" %>"><%= "#{hour}:00 - #{hour + 1}:30" %></option>
              <% end %>
            </select>
            <p id="slot-status"></p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <a href="#" id="book-session-btn" class="book-session-btn">Book Session</a>
      </div>
    </div>
  </div>

  <script>
    let currentExpertId = null;

    // ActionCable Setup
    const cable = ActionCable.createConsumer('/cable');

    function showModal(name, designation, age, experience, about, charges, expertId) {
      const modal = document.getElementById('expertModal');
      currentExpertId = expertId;

      modal.querySelector('#modalExpertName').textContent = name;
      modal.querySelector('.designation').textContent = designation || "Designation not specified";
      modal.querySelector('#modalAge').textContent = age || "Not specified";
      modal.querySelector('#modalExperience').textContent = experience ? `${experience} years` : "Not specified";
      modal.querySelector('#modalAbout').textContent = about || "No description available";
      modal.querySelector('.session-charges').textContent = charges ? `Session Charges: ₹${charges}` : "Session Charges: Not specified";

      const today = new Date().toISOString().split('T')[0];
      const dateInput = document.getElementById('booking-date');
      dateInput.value = today;
      dateInput.min = today;

      fetchAvailableSlots(expertId, today);

      dateInput.onchange = () => fetchAvailableSlots(expertId, dateInput.value);

      const bookButton = modal.querySelector('#book-session-btn');
      bookButton.onclick = bookSession;

      modal.classList.add('show');
      modal.classList.remove('hidden');

      // Subscribe to BookingsChannel for this expert
      cable.subscriptions.create({ channel: "BookingsChannel", expert_id: expertId }, {
        received(data) {
          console.log("Booking update received:", data);
          if (data.action === "booking_created" && data.expert_id == expertId) {
            fetchAvailableSlots(expertId, document.getElementById('booking-date').value);
          }
        }
      });
    }

    function closeModal() {
      const modal = document.getElementById('expertModal');
      modal.classList.remove('show');
      modal.classList.add('hidden');
      currentExpertId = null;
    }

    window.onclick = function(event) {
      const modal = document.getElementById('expertModal');
      if (event.target === modal) {
        closeModal();
      }
    };

    async function fetchAvailableSlots(expertId, date) {
      const timeSelect = document.getElementById('booking-time');
      const status = document.getElementById('slot-status');
      status.textContent = "Checking availability...";

      try {
        const response = await fetch(`/bookings/available_slots?expert_id=${expertId}&date=${date}`, {
          headers: { 'Accept': 'application/json' }
        });
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const slots = await response.json();

        timeSelect.innerHTML = '<option value="">Select a time slot</option>';
        const allSlots = Array.from({ length: 11 }, (_, i) => `${i + 9}:00`);
        allSlots.forEach(slot => {
          const isAvailable = !slots.booked.includes(slot);
          const option = document.createElement('option');
          option.value = slot;
          option.text = `${slot} - ${parseInt(slot) + 1}:30${isAvailable ? '' : ' (Booked)'}`;
          option.disabled = !isAvailable;
          timeSelect.appendChild(option);
        });

        status.textContent = slots.booked.length > 0 ? "Some slots are booked." : "All slots available.";
      } catch (error) {
        console.error('Error fetching slots:', error);
        status.textContent = "Error loading slots.";
      }
    }

    async function bookSession() {
      const selectedDate = document.getElementById('booking-date').value;
      const selectedTime = document.getElementById('booking-time').value;
      const bookButton = document.getElementById('book-session-btn');

      if (!selectedDate || !selectedTime) {
        alert('Please select both date and time slot');
        return false;
      }

      bookButton.classList.add('disabled');
      bookButton.textContent = "Booking...";

      try {
        const response = await fetch('/bookings', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector("[name='csrf-token']").content
          },
          body: JSON.stringify({
            expert_id: currentExpertId,
            session_date: selectedDate,
            time_slot: selectedTime
          })
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error || 'Failed to create booking');
        }

        alert('Session booked successfully!');
        closeModal();
      } catch (error) {
        console.error('Error:', error);
        alert(error.message || 'Something went wrong. Please try again.');
      } finally {
        bookButton.classList.remove('disabled');
        bookButton.textContent = "Book Session";
      }
    }

    // Search Bar Logic
    document.getElementById('expert-search').addEventListener('input', function() {
      const query = this.value.toLowerCase().trim();
      const cards = document.querySelectorAll('.expert-card');
      let hasMatches = false;

      const match = query.match(/^(age|experience|charges)\s*(>|>=|<|<=|=)?\s*(\d+)$/);
      
      cards.forEach(card => {
        const name = card.dataset.name || '';
        const designation = card.dataset.designation || '';
        const updatedAt = card.dataset.updatedAt || '';
        const age = Number(card.dataset.age);
        const experience = Number(card.dataset.experience);
        const charges = Number(card.dataset.charges);

        let matches = false;

        if (match) {
          const field = match[1];
          const operator = match[2] || '=';
          const value = Number(match[3]);
          const fieldValue = field === 'age' ? age : field === 'experience' ? experience : charges;

          switch (operator) {
            case '>': matches = fieldValue > value; break;
            case '>=': matches = fieldValue >= value; break;
            case '<': matches = fieldValue < value; break;
            case '<=': matches = fieldValue <= value; break;
            case '=': default: matches = fieldValue === value; break;
          }
        } else {
          matches = 
            name.includes(query) ||
            designation.includes(query) ||
            updatedAt.includes(query);
        }

        card.style.display = matches ? 'block' : 'none';
        hasMatches = hasMatches || matches;
      });

      document.getElementById('no-results').classList.toggle('hidden', hasMatches);
    });
  </script>
</body>
</html>